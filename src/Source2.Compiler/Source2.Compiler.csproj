<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source2.Compiler - authors compiled Source 2 resources in pure managed code.

    No project references: the container, KV3 reader and writer, and every resource
    reader are this project's own (docs/INDEPENDENCE.md). It does not use
    ValveResourceFormat.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Source2.Compiler</RootNamespace>
    <AssemblyName>Source2.Compiler</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8002;CS1591</NoWarn>
    <!-- Native/ holds the vendored bc7enc C sources; keep them out of the
         default item globs (they are built by CMake, not msbuild). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Native\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Source2.Compiler.Cli" />
    <InternalsVisibleTo Include="s2c" />
    <InternalsVisibleTo Include="Source2.Compiler.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library takes ILogger by interface only; the host wires the impl. -->
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- The KV tree (KVObject) and KV3 text (SteamDatabase's ValveKeyValue, not VRF; unpatched). The version
         is the one VRF 661a5f58 brought in before, so nothing reads differently; docs/INDEPENDENCE.md plans
         its replacement too. -->
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
    <!-- main's own KV3 / container stack (Kv3/, Compression/): KV3 Zstd blocks, RED2 CRCs, a VPK
         reader for template lookup. -->
    <PackageReference Include="ValvePak" Version="6.0.0.182" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <!-- Image decode/encode + mip generation, and the managed BC1/BC3/BC7 fallback. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>

  <!-- Valve's BC7 encoder (bc7e, level 6) with one CPU vendor's rcpps table each, prebuilt by
       Native/bc7e/build.ps1 and build.sh; RcTexture.Bc7e loads them from runtimes/<rid>/native. -->
  <ItemGroup>
    <Content Include="Native\bc7e\prebuilt\win-x64\*.dll" Link="runtimes\win-x64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" PackagePath="runtimes\win-x64\native" />
    <Content Include="Native\bc7e\prebuilt\linux-x64\*.so" Link="runtimes\linux-x64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" PackagePath="runtimes\linux-x64\native" />
  </ItemGroup>

  <ItemGroup>
    <!-- Optional native BC7 encoder. Absent (no C toolchain) => Bc7Native.Available
         is false and BuildTexture transparently falls back to BCnEncoder.Net.
         Build it with cmake; see Native/bc7enc/CMakeLists.txt. -->
    <Content Include="Native\bc7enc\bin\bc7enc_native.dll" Condition="Exists('Native\bc7enc\bin\bc7enc_native.dll')" Link="bc7enc_native.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Native\bc7enc\bin\libbc7enc_native.so" Condition="Exists('Native\bc7enc\bin\libbc7enc_native.so')" Link="libbc7enc_native.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- rsqrtps per CPU vendor, for normal maps (Texture/Rc/RcNormalMaps.cs), and the KV3 string table. -->
    <EmbeddedResource Include="Texture/Rc/rsqrt_amd.txt;Texture/Rc/rsqrt_intel.txt" LogicalName="Source2.Compiler.RcTexture.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Containers/KnownStrings.txt" LogicalName="Source2.Compiler.KnownStrings.txt" />
    <!-- The zstd dictionaries of CS2's shader bytecode, from materialsystem2.dll (tools/re/vfx_zstd_dicts.py). -->
    <EmbeddedResource Include="Shaders/Vfx/Resources/vfx_zstd_*.bin" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
    <!-- The GPU's measured BC1-BC5 decode (Textures.Decoding.BcGpuDecode; tools/re/bc_gpu_tables.py). -->
    <!-- WithCulture false: MSBuild would read ".bin" in the name as a culture and move them to a satellite assembly. -->
    <EmbeddedResource Include="Texture/Decoding/Gpu/*.bin.gz" LogicalName="Source2.Compiler.BcGpu.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
