<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source2.Compiler.Solvers - constraint solvers the decompiler hands problems to, kept out of
    Source2.Compiler so the compiler itself takes no solver dependency: the world soup's input order
    as one CP-SAT model (OR-Tools), installed into WorldGeometry.OrderSolver by the host.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Source2.Compiler.Solvers</RootNamespace>
    <AssemblyName>Source2.Compiler.Solvers</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="s2c" />
    <InternalsVisibleTo Include="Source2.Compiler.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Source2.Compiler\Source2.Compiler.csproj" />
    <PackageReference Include="Google.OrTools" Version="9.15.6755" />
  </ItemGroup>

</Project>
