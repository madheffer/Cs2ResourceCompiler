<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source2.MapCompiler - the .vmap compile: world nodes, visibility, world physics,
    lighting, cubemaps, Steam Audio, nav, the entity lump and the vphysics settle.

    Built on the resource compiler (Source2.Compiler), which knows nothing of maps.
    Namespaces are the ones these files had inside Source2.Compiler
    (Source2.Compiler.Maps, .Lighting, ...), so the move changed no code.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Source2.Compiler</RootNamespace>
    <AssemblyName>Source2.MapCompiler</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8002;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Source2.Compiler.Cli" />
    <InternalsVisibleTo Include="s2c" />
    <InternalsVisibleTo Include="Source2.Compiler.Tests" />
    <InternalsVisibleTo Include="Source2.Compiler.Gpu" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Source2.Compiler\Source2.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zen 4's rcpss/rsqrtss results by top mantissa bits, for CpuEstimate. -->
    <EmbeddedResource Include="Resources\estimate_zen4_*.bin" LogicalName="%(Filename)%(Extension)" />
    <!-- The materials the engine creates whatever the map, in creation order (CubemapFaceDrawList.MaterialOrder). -->
    <EmbeddedResource Include="Resources\cubemap_engine_materials.txt" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
